{
  "name": "swarmgeddon-leaderboard",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker + D1 global leaderboard for SWARMGEDDON",
  "scripts": {
    "dev": "wrangler dev",
    "dev:test": "wrangler dev --local --port 8788 --ip 127.0.0.1 --persist-to .wrangler/test --var IP_SALT:local-only --var DEV_ROUTES:1",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create swarmgeddon",
    "db:migrate": "wrangler d1 execute swarmgeddon --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute swarmgeddon --local --file=./schema.sql",
    "db:migrate:test": "wrangler d1 execute swarmgeddon --local --persist-to .wrangler/test --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240919.0",
    "wrangler": "^3.78.0"
  }
}
