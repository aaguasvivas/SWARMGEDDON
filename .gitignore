# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.local

# env (the leaderboard URL is set per-deploy; see .env.example + server/README.md)
.env
.env.*
!.env.example

# wrangler local state (server/)
server/.wrangler/

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# capacitor native build artifacts (the platform projects' own .gitignore files
# also cover Pods/, build/, .gradle/, and the copied web `public/` assets).
ios/App/Pods/
ios/App/build/
ios/DerivedData/
android/.gradle/
android/app/build/
android/build/
android/local.properties

# regenerable PWA icon output from `npm run assets:generate`
/icons/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
