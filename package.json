{
  "name": "swarmgeddon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SWARMGEDDON — a top-down twin-stick alien-hive survival shooter. Web-first, cross-platform.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cap": "tsc --noEmit && vite build --mode capacitor",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build:cap && cap sync",
    "cap:ios": "npm run build:cap && cap sync ios && cap open ios",
    "cap:android": "npm run build:cap && cap sync android && cap open android",
    "assets:generate": "capacitor-assets generate --assetPath assets"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.2"
  }
}
