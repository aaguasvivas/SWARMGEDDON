# Leaderboard worker (server/). Production builds post to the production URL
# committed in src/net/leaderboard.ts; set this only to point a build elsewhere.
# Dev builds read boards from this URL when it is set, and never post unless
# VITE_LEADERBOARD_DEV_SUBMIT is set too (for a local worker, see server/README.md).
VITE_LEADERBOARD_URL=
VITE_LEADERBOARD_DEV_SUBMIT=
